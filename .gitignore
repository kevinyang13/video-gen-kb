.DS_Store
.obsidian/workspace.json
.claude/settings.local.json
raw/photos/
# Per project: keep the recipe, drop the generated pixels.
#   tracked  -> plan/*.md, spec.json, prompt and lock .txt, raw/ source material
#   ignored  -> every generated image, video and audio file, plus logs
# (no trailing comments on a pattern line — git reads them as part of the pattern)
projects/*/*/seed/**
projects/*/*/stills/**
projects/*/*/clips/**
projects/*/*/final/**
projects/*/*/music/**
projects/*/*/logs/**
# scratch from older runs; film_run writes candidates to seed/ now
projects/*/*/work/**
# ...but the recipe inside those folders stays
!projects/*/*/seed/**/
!projects/*/*/seed/**/*.txt
!projects/*/*/seed/*.txt
# prompts are materialised from spec.json at run time
projects/*/*/.gen/
!projects/*/*/stills/**/
!projects/*/*/logs/**
# scratch from older runs; film_run writes candidates to seed/ now
projects/*/*/work/**/
!projects/*/*/logs/*.sh
# upscale stamps are build cache, not recipe
projects/*/*/clips/*_trim.txt
# large or personal source sets stay out entirely
projects/dragon_epic/*/raw/
projects/lost_city/*/raw/
projects/ivy_lora/*/raw/
projects/kyle_lora/*/raw/
projects/lindsey_lora/*/raw/

# draw-things-cli train lora writes a ~400 MB UUID-named scratch file into the CWD and
# keeps it open for the whole run; do not delete one while a training job is alive
/[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]-*-*-*-*
# collage.sh's default output, when run from the repo root
/collage.png
/collage_preview.jpg
tools/draw-things-community/
tools/*.log

# Third-party reference images supplied for a project are kept locally but not published.
# The repo is public; the specs reference them by filename, which is enough to reproduce a run.
projects/*/*/raw/*.jpg
projects/*/*/raw/*.jpeg
projects/*/*/raw/*.webp
projects/*/*/raw/*.png

# deep research working notes (the delivered report is tracked, its scratch notes are not)
research_notes/
